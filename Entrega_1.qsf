set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY toplevel
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "08:36:34  AUGUST 17, 2020"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"


set_location_assignment PIN_Y26 -to fpga_clk_50

set_location_assignment PIN_AK3 -to stepmotor_pio[3]
set_location_assignment PIN_Y16 -to stepmotor_pio[2]
set_location_assignment PIN_AK2 -to stepmotor_pio[1]
set_location_assignment PIN_W15 -to stepmotor_pio[0]

set_location_assignment PIN_AA24 -to fpga_led_pio[5]
set_location_assignment PIN_AB23 -to fpga_led_pio[4]

set_location_assignment PIN_AB30 -to stepmotor_en
set_location_assignment PIN_Y27 -to stepmotor_dir
set_location_assignment PIN_AB28 -to stepmotor_vel[0]
set_location_assignment PIN_AC30 -to stepmotor_vel[1]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name SDC_FILE SDC1.sdc
set_global_assignment -name VHDL_FILE toplevel.vhd
set_global_assignment -name VHDL_FILE stepmotor.vhd
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
# ============================================================================
# Pinos acrescentados na versao 3 (itens A + B)
#
# Fontes, para nao inventar pinagem:
#   - fpga_clk_50, stepmotor_pio, stepmotor_en/dir/vel e fpga_led_pio[5..4]
#     ja estavam neste arquivo, vindos do projeto de exemplo da disciplina.
#   - fpga_led_pio[3..0] copiados de ../../Lab1_FPGA_RTL.qsf
#   - stepmotor_steps[5..0] (SW9..SW4), stepmotor_start (KEY0) e
#     stepmotor_rst (KEY3) conforme o DE10-Standard User Manual.
# ============================================================================

# ---- LEDs restantes --------------------------------------------------------
set_location_assignment PIN_AC23 -to fpga_led_pio[3]
set_location_assignment PIN_AD24 -to fpga_led_pio[2]
set_location_assignment PIN_AG25 -to fpga_led_pio[1]
set_location_assignment PIN_AF25 -to fpga_led_pio[0]

# ---- Numero de passos: SW[9..4] --------------------------------------------
# SW[4]
set_location_assignment PIN_W25  -to stepmotor_steps[0]
# SW[5]
set_location_assignment PIN_V25  -to stepmotor_steps[1]
# SW[6]
set_location_assignment PIN_AC28 -to stepmotor_steps[2]
# SW[7]
set_location_assignment PIN_AD30 -to stepmotor_steps[3]
# SW[8]
set_location_assignment PIN_AC29 -to stepmotor_steps[4]
# SW[9]
set_location_assignment PIN_AA30 -to stepmotor_steps[5]

# ---- Botoes (ativos em BAIXO) ----------------------------------------------
# KEY[0]
set_location_assignment PIN_AJ4  -to stepmotor_start
# KEY[3]
set_location_assignment PIN_AA15 -to stepmotor_rst

# ---- Padrao de I/O ---------------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_pio[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_pio[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_pio[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_pio[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_en
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_dir
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_vel[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_vel[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_steps[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_steps[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_steps[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_steps[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_steps[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_steps[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_start
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to stepmotor_rst
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_led_pio[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_led_pio[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_led_pio[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_led_pio[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_led_pio[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fpga_led_pio[5]

# ---- Seguranca -------------------------------------------------------------
# Pinos nao usados ficam como entrada em alta impedancia. Sem isso a FPGA pode
# sair dirigindo nivel logico em pinos ligados a perifericos da placa.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"